<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:contentDescription="cart-screen">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cart"
        android:textColor="#FFE6F0FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingLeft="16dp"/>

    <ListView
        android:id="@+id/cart_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:scrollbars="none"
        android:contentDescription="cart-list"/>

    <TextView
        android:id="@+id/cart_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/empty_cart"
        android:textColor="#FFA9B4D6"
        android:textSize="14sp"
        android:visibility="gone"
        android:contentDescription="cart-empty"/>

    <LinearLayout
        android:id="@+id/cart_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_margin="12dp"
        android:padding="14dp"
        android:contentDescription="cart-summary">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/cart_subtotal"
                android:textColor="#FFA9B4D6"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/cart_subtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE6F0FF"
                android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/cart_shipping"
                android:textColor="#FFA9B4D6"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/cart_shipping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE6F0FF"
                android:textSize="13sp"
                android:text="@string/cart_free_ship"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/cart_tax"
                android:textColor="#FFA9B4D6"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/cart_tax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE6F0FF"
                android:textSize="13sp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#221F2540"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/cart_total"
                android:textColor="#FFE6F0FF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/cart_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB6FF38"
                android:textSize="18sp"
                android:textStyle="bold"
                android:contentDescription="cart-total"/>
        </LinearLayout>
        <Button
            android:id="@+id/cart_checkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_checkout"
            android:layout_marginTop="14dp"
            style="@style/PrimaryButton"
            android:contentDescription="cart-checkout"/>
    </LinearLayout>
</LinearLayout>
