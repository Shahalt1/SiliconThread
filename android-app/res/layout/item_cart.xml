<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:padding="12dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginTop="8dp">

    <View
        android:id="@+id/cart_item_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/product_image_bg"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="10dp"
        android:layout_gravity="center_vertical">
        <TextView
            android:id="@+id/cart_item_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF22D3EE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>
        <TextView
            android:id="@+id/cart_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFE6F0FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/cart_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFB6FF38"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <TextView
                android:id="@+id/cart_qty_dec"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="−"
                android:textColor="#FFE6F0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="cart-qty-dec"/>
            <TextView
                android:id="@+id/cart_qty"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:textColor="#FFE6F0FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:contentDescription="cart-qty-value"/>
            <TextView
                android:id="@+id/cart_qty_inc"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="+"
                android:textColor="#FFE6F0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="cart-qty-inc"/>
            <TextView
                android:id="@+id/cart_remove"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="REMOVE"
                android:textColor="#FFFF4D6D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="cart-remove"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
