<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:padding="12dp"
    android:layout_marginTop="6dp">

    <View
        android:id="@+id/order_line_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/product_image_bg"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="10dp"
        android:layout_gravity="center_vertical">
        <TextView
            android:id="@+id/order_line_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF22D3EE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>
        <TextView
            android:id="@+id/order_line_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFE6F0FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/order_line_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFA9B4D6"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/order_line_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFB6FF38"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="center_vertical"/>
</LinearLayout>
