<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:contentDescription="splash-screen">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="splash-logo"/>

        <TextView
            android:id="@+id/splash_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SILICONTHREAD"
            android:textColor="#FFE6F0FF"
            android:textSize="28sp"
            android:letterSpacing="0.3"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:contentDescription="splash-brand"/>

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="#FF22D3EE"
            android:textSize="14sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="6dp"
            android:contentDescription="splash-tagline"/>

        <ProgressBar
            android:id="@+id/splash_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            style="?android:attr/progressBarStyleSmall"
            android:indeterminateTint="#FFB6FF38"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="v1.0  •  built for Appium"
        android:textColor="#FF6E789B"
        android:textSize="11sp"
        android:layout_marginBottom="24dp"
        android:contentDescription="splash-version"/>
</FrameLayout>
