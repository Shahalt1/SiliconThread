<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:contentDescription="search-screen">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search"
        android:textColor="#FFE6F0FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingLeft="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/search_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌕"
            android:textColor="#FF22D3EE"
            android:textSize="22sp"
            android:paddingLeft="14dp"/>

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/action_search_hint"
            android:textColorHint="#FF6E789B"
            android:textColor="#FFE6F0FF"
            android:background="@color/transparent"
            android:padding="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:contentDescription="search-input"
            android:inputType="text"/>

        <TextView
            android:id="@+id/search_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFA9B4D6"
            android:textSize="16sp"
            android:paddingLeft="8dp"
            android:paddingRight="14dp"
            android:contentDescription="search-clear"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/search_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFA9B4D6"
        android:textSize="12sp"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:text="Try: RTX 5090, Ryzen, Coral, DDR5…"
        android:contentDescription="search-status"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/search_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingRight="16dp"
            android:contentDescription="search-chips"/>
    </HorizontalScrollView>

    <ListView
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:contentDescription="search-results"/>
</LinearLayout>
