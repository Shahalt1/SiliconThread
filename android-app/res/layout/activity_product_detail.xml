<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="14dp"
        android:paddingTop="14dp">
        <TextView
            android:id="@+id/detail_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#FF22D3EE"
            android:textSize="24sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:contentDescription="detail-back"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Product"
            android:textColor="#FFE6F0FF"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/detail_wishlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡"
            android:textColor="#FFFF3DAA"
            android:textSize="22sp"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:contentDescription="detail-wishlist"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:contentDescription="detail-scroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <HorizontalScrollView
                android:id="@+id/detail_carousel"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scrollbars="none"
                android:contentDescription="detail-carousel">
                <LinearLayout
                    android:id="@+id/detail_carousel_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"/>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/carousel_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:paddingTop="6dp"
                android:contentDescription="carousel-dots"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/detail_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF22D3EE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:contentDescription="detail-brand"/>

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFE6F0FF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:contentDescription="detail-name"/>

                <TextView
                    android:id="@+id/detail_short"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFA9B4D6"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="detail-short"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/detail_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFB6FF38"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:contentDescription="detail-price"/>
                    <TextView
                        android:id="@+id/detail_original"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF6E789B"
                        android:textSize="14sp"
                        android:layout_marginLeft="10dp"
                        android:visibility="gone"
                        android:contentDescription="detail-original"/>
                    <TextView
                        android:id="@+id/detail_deal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/badge_deal"
                        android:textColor="#FF000000"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:contentDescription="detail-deal"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFB020"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="detail-rating"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/description"
                    style="@style/TextLabel"
                    android:layout_marginTop="18dp"/>
                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFA9B4D6"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="detail-description"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/specifications"
                    style="@style/TextLabel"
                    android:layout_marginTop="18dp"/>
                <LinearLayout
                    android:id="@+id/detail_specs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:contentDescription="detail-specs"/>

                <TextView
                    android:id="@+id/detail_benchmarks_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/benchmarks"
                    style="@style/TextLabel"
                    android:layout_marginTop="18dp"/>
                <LinearLayout
                    android:id="@+id/detail_benchmarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/card_bg_alt"
                    android:padding="12dp"
                    android:contentDescription="detail-benchmarks"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FF0A0D1C">

        <Button
            android:id="@+id/detail_add_cart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_add_to_cart"
            style="@style/GhostButton"
            android:contentDescription="add-to-cart-button"/>

        <Button
            android:id="@+id/detail_buy_now"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_buy_now"
            style="@style/PrimaryButton"
            android:layout_marginLeft="10dp"
            android:contentDescription="buy-now-button"/>
    </LinearLayout>
</LinearLayout>
