<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:contentDescription="home-scroll"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SILICONTHREAD"
                    android:textColor="#FF22D3EE"
                    android:textStyle="bold"
                    android:letterSpacing="0.3"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/home_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forge your rig."
                    android:textColor="#FFE6F0FF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <TextView
                android:id="@+id/home_open_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textSize="22sp"
                android:textColor="#FF22D3EE"
                android:paddingLeft="12dp"
                android:paddingRight="6dp"
                android:contentDescription="home-search-icon"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/home_open_profile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="◉"
                android:textSize="18sp"
                android:textColor="#FF000000"
                android:textStyle="bold"
                android:background="@drawable/btn_neon"
                android:layout_marginLeft="8dp"
                android:contentDescription="home-profile-icon"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_alt"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="16dp"
            android:padding="18dp"
            android:contentDescription="home-hero-card"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DROP ZONE • RTX 5090"
                android:textColor="#FFF000FF"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:textSize="11sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwell unleashed."
                android:textColor="#FFE6F0FF"
                android:textStyle="bold"
                android:textSize="24sp"
                android:layout_marginTop="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32GB GDDR7 • 4500 AI TOPS • 240 FPS @ 4K"
                android:textColor="#FFB6FF38"
                android:textSize="12sp"
                android:layout_marginTop="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From $1,999"
                android:textColor="#FFE6F0FF"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <TextView style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_featured"
            android:paddingLeft="16dp"
            android:paddingTop="20dp"
            android:contentDescription="section-featured-label"/>
        <HorizontalScrollView
            android:id="@+id/row_featured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:scrollbars="none"
            android:contentDescription="row-featured">
            <LinearLayout
                android:id="@+id/row_featured_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_trending"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:contentDescription="section-trending-label"/>
        <HorizontalScrollView
            android:id="@+id/row_trending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:scrollbars="none"
            android:contentDescription="row-trending">
            <LinearLayout
                android:id="@+id/row_trending_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_ai"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:contentDescription="section-ai-label"/>
        <HorizontalScrollView
            android:id="@+id/row_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:scrollbars="none"
            android:contentDescription="row-ai">
            <LinearLayout
                android:id="@+id/row_ai_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_deals"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:contentDescription="section-deals-label"/>
        <HorizontalScrollView
            android:id="@+id/row_deals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:scrollbars="none"
            android:contentDescription="row-deals">
            <LinearLayout
                android:id="@+id/row_deals_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_recommended"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:contentDescription="section-recommended-label"/>
        <HorizontalScrollView
            android:id="@+id/row_reco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:contentDescription="row-recommended">
            <LinearLayout
                android:id="@+id/row_reco_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
