<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:contentDescription="wishlist-screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Wishlist"
            android:textColor="#FFE6F0FF"
            android:textSize="22sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/wishlist_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF22D3EE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:contentDescription="wishlist-count"/>
    </LinearLayout>

    <ListView
        android:id="@+id/wishlist_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:scrollbars="none"
        android:contentDescription="wishlist-list"/>

    <TextView
        android:id="@+id/wishlist_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_wishlist"
        android:textColor="#FFA9B4D6"
        android:textSize="14sp"
        android:visibility="gone"
        android:contentDescription="wishlist-empty"/>
</LinearLayout>
