            <corners android:radius="12dp" />
            <gradient android:angle="45" android:startColor="#FF1FA8C7" android:endColor="#FFB6FF38" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="45" android:startColor="#FF22D3EE" android:endColor="#FFB6FF38" />
        </shape>
    </item>
</selector>
